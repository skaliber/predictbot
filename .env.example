# PredictCamp public API (https://predictcamp.ro/api/public/v1)
# Cheia trebuie să aibă scope=admin ca să primească market_odds (cotele 1X2).
PREDICTCAMP_API_BASE_URL=https://predictcamp.ro/api/public/v1
PREDICTCAMP_API_KEY=
PREDICTCAMP_LOCALE=ro

# Fallback: internal open endpoints (fără cheie, doar listare meciuri)
PREDICTCAMP_FALLBACK_BASE_URL=https://predictcamp.ro/api

# Rate limit client. API-ul public dă 120/min; conturile admin au 6000/min
# (spec 087, live din 2026-09-20). Pe cheie admin: 1000. Pe cheie normală: 100.
API_MAX_RPM=1000

# football-data.org (free tier) — opțional, pentru fixtures independente
FOOTBALL_DATA_TOKEN=

# Server
PORT=3081
BOT_ID=ai-analyst

# Politica de selecție a pariurilor
MIN_EDGE_PCT=3
MIN_CONFIDENCE=52
KELLY_FRACTION=0.25
MAX_KELLY_STAKE=0.05

# Cron: câte ore înainte de start se generează predicțiile
HOURS_AHEAD=48
HOURS_MIN=2
